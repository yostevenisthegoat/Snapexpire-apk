<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SnapFade" parent="android:Theme.DeviceDefault.NoActionBar" />

    <style name="Theme.SnapFade.Translucent" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
</resources>
